#%RAML 1.0 Library

uses:
  matchingField:  matching_field_library.raml

types:
  getRecordExists:
    type: object
    properties:
      MatchingField:
        type: matchingField.matchingField
        required: true
        example:
          MatchingFieldName: "Id"
          MatchingFieldValue: "0039p00000XkzVLAAZ"
      ObjectName:
        type: string
        required: true
        example: "Referral__c"
        minLength: 1
